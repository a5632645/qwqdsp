// ── 比较函数 ──

template<class T>
static int CheckRef(const char* name, const T* computed, const T* ref, int n,
                      T abs_tol, T rel_tol) noexcept {
    int errs = 0;
    T max_abs_err = 0, max_rel_err = 0;
    for (int i = 0; i < n; ++i) {
        T abs_err = std::abs(computed[i] - ref[i]);
        T rel_err = abs_err / (std::abs(ref[i]) + T(1e-30));
        max_abs_err = std::max(max_abs_err, abs_err);
        max_rel_err = std::max(max_rel_err, rel_err);
        if (abs_err > abs_tol && rel_err > rel_tol)
            ++errs;
    }
    std::printf("  %-14s  n=%4d  max_abs_err=%8.2e  max_rel_err=%8.2e  errs=%d\n",
               name, n, double(max_abs_err), double(max_rel_err), errs);
    return errs;
}

// ── 批量验证 ──

template<int N, class T, class Fn>
static int CheckAll(Fn fn, T* buf) noexcept {
    int total_errs = 0;
    for (int i = 0; i < N; ++i)
        buf[i] = fn(T(i) / T(N));
    return total_errs;
}